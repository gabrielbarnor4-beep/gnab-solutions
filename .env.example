# Client — required, throws at startup if missing (src/lib/supabase.ts + src/lib/utils.ts)
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/<your_form_id>

# Optional client — analytics (no key = no tracking)
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Server-only — never VITE_, set via `supabase secrets set` (supabase/functions/*)
#   GEMINI_API_KEY=<google ai studio key>          # gemini-chat edge
#   BREVO_API_KEY=<brevo api key>                  # send-email preferred
#   RESEND_API_KEY=<resend api key>                # send-email fallback
#   FROM_EMAIL=GNAB Business Solutions <gnabsolutions@gmail.com>
#   ALLOWED_ORIGIN=https://gnab-solutions.vercel.app  # CORS lockdown, defaults to localhost+supabase origin
# Example:
#   supabase secrets set GEMINI_API_KEY=... ALLOWED_ORIGIN=https://gnab-solutions.vercel.app BREVO_API_KEY=...
#   supabase functions deploy gemini-chat --no-verify-jwt
#   supabase functions deploy send-email --no-verify-jwt
